# Local Claude guidance. Kept out of the repo on purpose.
CLAUDE.md

# macOS
.DS_Store
*.pem

# Local scratch database built from schema.sql for manual testing.
# Not source, just a throwaway file you get by running:
#   sqlite3 tip-tracker.db < schema.sql
*.db

# Invented shift histories used to exercise the CSV importer by hand. Nothing
# in the repo reads them and nothing generates them, so they are local scratch
# in the same sense as the database above -- if a reviewer ever needs sample
# import data, it wants a generator script and a note, not a pile of CSVs.
fake-data/

# Local design references. Keep them on this Mac without uploading them to Git
# or including them in the EAS build archive.
Visual-Inspiration/

# NOTE: running create-expo-app overwrites both this file and README.md with
# its own versions. Afterward: re-add the CLAUDE.md line above, or CLAUDE.md
# starts getting tracked without anyone noticing, and restore README.md from
# git rather than keeping the Expo default.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Local agent tooling
.fallow/
.playwright-cli/
# Skills an agent installs for itself, plus the lockfile pinning their
# versions. Vendored from supabase/agent-skills; nothing in this repo reads
# either one, so they stay out like the two above. .claude/skills/ is only
# symlinks into .agents/, so it goes too -- but .claude/settings.json is
# tracked, which is why this ignores the subdirectory and not all of .claude.
.agents/
skills-lock.json
.claude/skills/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
